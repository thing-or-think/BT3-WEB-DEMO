# Port chạy ứng dụng web demo
PORT=3000

# (Tùy chọn) Cấu hình GitHub OAuth App
# Nếu bạn muốn test luồng 1-click "Login with GitHub" chính quy:
# 1. Truy cập https://github.com/settings/developers
# 2. Tạo 'New OAuth App'
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/api/auth/callback
# 5. Dán Client ID và Client Secret vào đây:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
